{
  "version": 1,
  "key": "mater-data/product",
  "label": "Products",
  "singularLabel": "Product",
  "parent": "mater-data",
  "routeBase": "mater-data/products",
  "permissionKey": "product",
  "apiPlural": "products",
  "moduleType": "crud",
  "features": {
    "list": true,
    "detail": true,
    "create": true,
    "edit": true,
    "delete": true,
    "bulkUpload": true,
    "export": true
  },
  "fields": [
    {
      "name": "productName",
      "label": "Product Name",
      "type": "textField",
      "rules": [
        "required",
        "min:3",
        "max:100",
        "withoutemoticon",
        "unique"
      ],
      "source": "none",
      "sortable": true,
      "filterable": false,
      "filterCriteria": null
    },
    {
      "name": "productCode",
      "label": "Product Code",
      "type": "textField",
      "rules": [
        "required",
        "min:4",
        "max:4",
        "withoutemoticon",
        "unique"
      ],
      "source": "none",
      "sortable": false,
      "filterable": false,
      "filterCriteria": null
    },
    {
      "name": "category",
      "label": "Category",
      "type": "selectField",
      "rules": [
        "required",
        "withoutemoticon"
      ],
      "source": "mockPagingInfinityScroll",
      "sortable": false,
      "filterable": true,
      "filterCriteria": "optionExact"
    }
  ],
  "layout": {
    "form": [
      {
        "field": "productName",
        "order": 0,
        "colSpan": 12
      },
      {
        "field": "productCode",
        "order": 1,
        "colSpan": 12
      },
      {
        "field": "category",
        "order": 2,
        "colSpan": 12
      }
    ],
    "table": {
      "order": [
        "productName",
        "productCode",
        "category"
      ],
      "hidden": []
    }
  },
  "deleteMode": "soft",
  "status": "published"
}
