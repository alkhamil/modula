{
  "name": "generator-module-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main",
    "start:dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main\"",
    "start:prod": "node dist/main",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/src/**/*.test.js\"",
    "test:e2e": "tsc -p tsconfig.test.json && npm run build && node --test \"dist-test/test/**/*.e2e-test.js\"",
    "typeorm": "typeorm",
    "migration:generate": "npm run build && npm run typeorm -- migration:generate -d dist/config/data-source.js",
    "migration:run": "npm run build && npm run typeorm -- migration:run -d dist/config/data-source.js",
    "seed": "npm run build && node dist/seeds/seed.js",
    "db:clean": "npm run build && node dist/seeds/clean.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mysql2": "^3.24.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  }
}
