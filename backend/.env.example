PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5175
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=rootpass
DB_NAME=appdb
# true hanya untuk test/e2e (buat skema otomatis); jangan di dev/prod.
DB_SYNCHRONIZE=false
JWT_SECRET=dev-secret-change-me
# Umur token dalam detik (86400 = 1 hari).
JWT_EXPIRES_IN=86400
# Password akun admin saat `npm run seed` (default: admin123).
ADMIN_PASSWORD=admin123
